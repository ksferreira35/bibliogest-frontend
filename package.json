{
  "name": "bibliogest-frontend",
  "private": true,
  "version": "0.1.6",
  "description": "Interface web do BiblioGest para consultar o acervo e reservar exemplares físicos.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksferreira35/bibliogest-frontend.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev:e2e": "vite --mode e2e --host 127.0.0.1 --port 4173",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open"
  },
  "dependencies": {
    "keycloak-js": "26.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.2",
    "axe-core": "^4.14.1",
    "cypress": "^15.21.2",
    "cypress-axe": "^1.7.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.2"
  }
}
